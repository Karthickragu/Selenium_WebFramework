<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="com.wellsfargo.test" parallel="methods" thread-count="1">


	<listeners>
		<listener class-name="com.radio.listener.TestListener" />
	</listeners>

	<test name="Test_Firefox" verbose="4">
		<parameter name="preferredBrowser" value="firefox" />
		<parameter name="platformVersion" value="" />
		<classes>
			<class name="com.radio.test.Regression" />
		</classes>
	</test>

	<test name="Test_Edge" >
		<parameter name="preferredBrowser" value="edge" />
		<parameter name="platformVersion" value="" />
		<classes>
			<class name="com.radio.test.Regression" />
		</classes>
	</test> 
	
	
	<test name="Test_Chrome" verbose="4">
		<parameter name="preferredBrowser" value="chrome" />
		<parameter name="platformVersion" value="" />
		<classes>
			<class name="com.radio.test.Regression" />
		</classes>
	</test>

</suite> 
